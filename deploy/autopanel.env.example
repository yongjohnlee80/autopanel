# /etc/autopanel/autopanel.env: root:autopanel 0640. Holds the deployment's
# settings and, for DNS-01, the Cloudflare token; never commit a filled copy.

# The gate's listeners. The shipped defaults are loopback; a deployment widens them.
AUTOPANEL_HTTP_ADDR=:80
AUTOPANEL_HTTPS_ADDR=:443

# ACME: "staging" (Let's Encrypt staging, the default), "production", or a directory URL.
AUTOPANEL_ACME_CA=staging
AUTOPANEL_ACME_EMAIL=admin@example.com

# Set to validate every certificate with DNS-01 through Cloudflare (needed for
# names behind Cloudflare's proxy). Unset: HTTP-01 and TLS-ALPN-01, which need
# the name's DNS to point straight at this host. Token scope: Zone.DNS:Edit on
# the zones served.
#AUTOPANEL_CLOUDFLARE_API_TOKEN=

# Peers whose CF-Connecting-IP header names the client: Cloudflare's published
# ranges (https://www.cloudflare.com/ips/), comma-separated. Empty trusts none.
#AUTOPANEL_TRUSTED_PROXIES=

# The store: SQLite under the StateDirectory by default.
#AUTOPANEL_STORE_ENGINE=postgres
#AUTOPANEL_POSTGRES_DSN=
