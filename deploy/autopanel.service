# AutoPanel as a systemd service. Install:
#   useradd --system --home-dir /var/lib/autopanel --shell /usr/sbin/nologin autopanel
#   install -m 0755 autopanel /usr/local/bin/autopanel
#   install -d -m 0750 -o root -g autopanel /etc/autopanel
#   install -m 0640 -o root -g autopanel autopanel.env /etc/autopanel/autopanel.env   # from autopanel.env.example
#   install -m 0644 autopanel.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now autopanel
# Admin: sudo -u autopanel autopanel --ui   (the control socket never leaves the host)

[Unit]
Description=AutoPanel control plane (reverse-proxy gate, ACME certificates)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=autopanel
Group=autopanel
EnvironmentFile=/etc/autopanel/autopanel.env
ExecStart=/usr/local/bin/autopanel --serve
Restart=on-failure
RestartSec=5s

# :80 and :443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The store and CertMagic's keys; the control socket. Both the service user's only.
StateDirectory=autopanel
StateDirectoryMode=0700
RuntimeDirectory=autopanel
RuntimeDirectoryMode=0700
UMask=0077

# The staging memory budget fails loudly: an overspend is killed, not swapped.
MemoryMax=100M
MemorySwapMax=0
Environment=GOMEMLIMIT=85MiB

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
